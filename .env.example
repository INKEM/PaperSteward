# PaperSteward 本地配置示例。
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密钥。

# 运行环境：dev / test / prod
PAPERSTEWARD_APP_ENV=dev
# 可选；只通过 Semantic Scholar 的 x-api-key 请求头发送，不用于离线 fixture。
# PAPERSTEWARD_SEMANTIC_SCHOLAR_API_KEY=

# 数据目录（数据库、导出、备份等）；相对路径按项目根目录解析
PAPERSTEWARD_DATA_DIR=./var

# 留空时自动使用 ${PAPERSTEWARD_DATA_DIR}/papersteward.db
# PAPERSTEWARD_DATABASE_URL=sqlite+pysqlite:///./var/papersteward.db

# 日志：DEBUG / INFO / WARNING / ERROR / CRITICAL
PAPERSTEWARD_LOG_LEVEL=INFO
# json（结构化，便于采集与回放）或 console（本地阅读）
PAPERSTEWARD_LOG_FORMAT=json

# 默认只绑定本机；本地单用户工具，无远程鉴权
PAPERSTEWARD_API_HOST=127.0.0.1
PAPERSTEWARD_API_PORT=8000

# 业务时区，必须是 IANA 时区名
PAPERSTEWARD_TIMEZONE=Asia/Shanghai

# LLM：默认 fake（离线）；真实调用需显式 `papersteward llm ping --live`
# 或网页 G4 数据范围 + 本次同步明确授权。openai_compatible 时 MODEL 必填。
PAPERSTEWARD_LLM_PROVIDER=fake
# 非本机地址必须使用 https；本机 Ollama 可用 http://127.0.0.1:11434/v1
PAPERSTEWARD_LLM_BASE_URL=https://api.openai.com/v1
# 只从环境/.env 读取，不要提交；也可直接设置同名环境变量。
# PAPERSTEWARD_LLM_API_KEY=
# PAPERSTEWARD_LLM_MODEL=
PAPERSTEWARD_LLM_TIMEOUT_S=30
PAPERSTEWARD_LLM_MAX_ATTEMPTS=3
# 可选：仅用于成本估算，不改变账单。
PAPERSTEWARD_LLM_PROMPT_COST_PER_1K_USD=0
PAPERSTEWARD_LLM_COMPLETION_COST_PER_1K_USD=0
# SMTP仅在G4明确选择smtp且显式digest --send-smtp时调用；默认无邮件调用。
PAPERSTEWARD_SMTP_HOST=
PAPERSTEWARD_SMTP_PORT=465
PAPERSTEWARD_SMTP_USERNAME=
PAPERSTEWARD_SMTP_PASSWORD=
PAPERSTEWARD_SMTP_FROM=
PAPERSTEWARD_SMTP_TO=
PAPERSTEWARD_SMTP_SECURITY=ssl
PAPERSTEWARD_SMTP_TIMEOUT_S=15
