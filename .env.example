# PaperSteward 本地配置示例。
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密钥。

# 运行环境：dev / test / prod
PAPERSTEWARD_APP_ENV=dev

# 数据目录（数据库、导出、备份等）；相对路径按项目根目录解析
PAPERSTEWARD_DATA_DIR=./var

# 留空时自动使用 ${PAPERSTEWARD_DATA_DIR}/papersteward.db
# PAPERSTEWARD_DATABASE_URL=sqlite+pysqlite:///./var/papersteward.db

# 日志：DEBUG / INFO / WARNING / ERROR / CRITICAL
PAPERSTEWARD_LOG_LEVEL=INFO
# json（结构化，便于采集与回放）或 console（本地阅读）
PAPERSTEWARD_LOG_FORMAT=json

# 默认只绑定本机；MVP 不做远程多用户访问
PAPERSTEWARD_API_HOST=127.0.0.1
PAPERSTEWARD_API_PORT=8000

# 业务时区，必须是 IANA 时区名
PAPERSTEWARD_TIMEZONE=Asia/Shanghai
